{
  "version": 1,
  "prepare": [],
  "checks": [
    {
      "id": "touching",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import merge_intervals;print(json.dumps(merge_intervals(json.loads(sys.argv[1]))))",
        "[[5,7],[1,3],[3,5]]"
      ],
      "expected_exit": 0,
      "expected_json": [
        [
          1,
          7
        ]
      ]
    },
    {
      "id": "nested",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import merge_intervals;print(json.dumps(merge_intervals(json.loads(sys.argv[1]))))",
        "[[1,10],[2,4],[12,14]]"
      ],
      "expected_exit": 0,
      "expected_json": [
        [
          1,
          10
        ],
        [
          12,
          14
        ]
      ]
    },
    {
      "id": "empty",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import merge_intervals;print(json.dumps(merge_intervals([])))"
      ],
      "expected_exit": 0,
      "expected_json": []
    }
  ]
}
