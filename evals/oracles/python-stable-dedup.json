{
  "version": 1,
  "prepare": [],
  "checks": [
    {
      "id": "duplicates",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import stable_unique;print(json.dumps(stable_unique(json.loads(sys.argv[1]))))",
        "[3,1,3,2,1]"
      ],
      "expected_exit": 0,
      "expected_json": [
        3,
        1,
        2
      ]
    },
    {
      "id": "empty",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import stable_unique;print(json.dumps(stable_unique(json.loads(sys.argv[1]))))",
        "[]"
      ],
      "expected_exit": 0,
      "expected_json": []
    },
    {
      "id": "strings",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import json,sys;sys.path.insert(0,'.');from solution import stable_unique;print(json.dumps(stable_unique(json.loads(sys.argv[1]))))",
        "[\"b\",\"a\",\"b\",\"c\"]"
      ],
      "expected_exit": 0,
      "expected_json": [
        "b",
        "a",
        "c"
      ]
    }
  ]
}
