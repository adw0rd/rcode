{
  "version": 1,
  "prepare": [
    {
      "argv": [
        "cargo",
        "build",
        "--offline",
        "--quiet",
        "--target-dir",
        "/agent-tmp/target"
      ],
      "timeout_secs": 60
    }
  ],
  "checks": [
    {
      "id": "preserve-first-order",
      "argv": [
        "/agent-tmp/target/debug/rust_dedup_order"
      ],
      "stdin": "4 2 4 3 2 1",
      "expected_exit": 0,
      "expected_json": [
        4,
        2,
        3,
        1
      ]
    },
    {
      "id": "empty",
      "argv": [
        "/agent-tmp/target/debug/rust_dedup_order"
      ],
      "stdin": "",
      "expected_exit": 0,
      "expected_json": []
    },
    {
      "id": "negative-and-limits",
      "argv": [
        "/agent-tmp/target/debug/rust_dedup_order"
      ],
      "stdin": "-1 0 -1 9223372036854775807 -9223372036854775808",
      "expected_exit": 0,
      "expected_json": [
        -1,
        0,
        9223372036854775807,
        -9223372036854775808
      ]
    }
  ]
}
