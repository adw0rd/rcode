{
  "version": 1,
  "prepare": [
    {
      "argv": [
        "cargo",
        "build",
        "--offline",
        "--quiet",
        "--target-dir",
        "/agent-tmp/target"
      ],
      "timeout_secs": 60
    }
  ],
  "checks": [
    {
      "id": "space-and-comma",
      "argv": [
        "/agent-tmp/target/debug/rust_parse_integer_list"
      ],
      "stdin": "12, -3  8",
      "expected_exit": 0,
      "expected_json": [
        12,
        -3,
        8
      ]
    },
    {
      "id": "empty-input",
      "argv": [
        "/agent-tmp/target/debug/rust_parse_integer_list"
      ],
      "stdin": "",
      "expected_exit": 0,
      "expected_json": []
    },
    {
      "id": "int32-limits",
      "argv": [
        "/agent-tmp/target/debug/rust_parse_integer_list"
      ],
      "stdin": "-2147483648,2147483647",
      "expected_exit": 0,
      "expected_json": [
        -2147483648,
        2147483647
      ]
    },
    {
      "id": "bad-token",
      "argv": [
        "/agent-tmp/target/debug/rust_parse_integer_list"
      ],
      "stdin": "1,nope,2",
      "expected_exit": 0,
      "expected_json": "error"
    }
  ]
}
