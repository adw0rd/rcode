{
  "version": 1,
  "prepare": [
    {
      "argv": [
        "tsc",
        "--strict",
        "--target",
        "ES2020",
        "--module",
        "commonjs",
        "--outDir",
        "/agent-tmp/js",
        "src/uniqueStable.ts"
      ],
      "timeout_secs": 30
    }
  ],
  "checks": [
    {
      "id": "preserves-order",
      "argv": [
        "node",
        "-e",
        "const {uniqueStable}=require('/agent-tmp/js/uniqueStable.js'); console.log(JSON.stringify(uniqueStable([3,1,3,2,1])))"
      ],
      "expected_exit": 0,
      "expected_json": [
        3,
        1,
        2
      ]
    },
    {
      "id": "empty-and-single",
      "argv": [
        "node",
        "-e",
        "const {uniqueStable}=require('/agent-tmp/js/uniqueStable.js'); console.log(JSON.stringify([uniqueStable([]),uniqueStable([7])]))"
      ],
      "expected_exit": 0,
      "expected_json": [
        [],
        [
          7
        ]
      ]
    },
    {
      "id": "does-not-mutate",
      "argv": [
        "node",
        "-e",
        "const {uniqueStable}=require('/agent-tmp/js/uniqueStable.js'); const a=[2,1,2]; uniqueStable(a); console.log(JSON.stringify(a))"
      ],
      "expected_exit": 0,
      "expected_json": [
        2,
        1,
        2
      ]
    }
  ]
}
