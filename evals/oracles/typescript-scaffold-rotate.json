{
  "version": 1,
  "prepare": [
    {
      "argv": [
        "tsc",
        "--strict",
        "--target",
        "ES2020",
        "--module",
        "commonjs",
        "--outDir",
        "/agent-tmp/js",
        "src/rotateRight.ts"
      ],
      "timeout_secs": 30
    }
  ],
  "checks": [
    {
      "id": "positive-shift",
      "argv": [
        "node",
        "-e",
        "const {rotateRight}=require('/agent-tmp/js/rotateRight.js'); console.log(JSON.stringify(rotateRight([1,2,3,4],1)))"
      ],
      "expected_exit": 0,
      "expected_json": [
        4,
        1,
        2,
        3
      ]
    },
    {
      "id": "negative-and-large",
      "argv": [
        "node",
        "-e",
        "const {rotateRight}=require('/agent-tmp/js/rotateRight.js'); console.log(JSON.stringify([rotateRight([1,2,3],-1),rotateRight([1,2,3],7)]))"
      ],
      "expected_exit": 0,
      "expected_json": [
        [
          2,
          3,
          1
        ],
        [
          3,
          1,
          2
        ]
      ]
    },
    {
      "id": "empty-and-immutable",
      "argv": [
        "node",
        "-e",
        "const {rotateRight}=require('/agent-tmp/js/rotateRight.js'); const a=[]; const b=[1,2]; rotateRight(b,1); console.log(JSON.stringify([rotateRight(a,5),b]))"
      ],
      "expected_exit": 0,
      "expected_json": [
        [],
        [
          1,
          2
        ]
      ]
    }
  ]
}
